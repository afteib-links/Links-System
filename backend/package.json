{
  "name": "links-system-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Links-System API server (Express + MariaDB)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/migrate.js",
    "seed:verification": "node scripts/seed_verification_data.js",
    "reset-and-seed:verification": "node scripts/seed_verification_data.js --reset",
    "verify:verification-data": "node scripts/seed_verification_data.js --verify",
    "preview:settlement-pdfs": "node scripts/generate_settlement_pdf_previews.js",
    "test:settlement-access": "node test-integration/settlement_access_api.js",
    "test:settlement-workflow": "node test-integration/settlement_workflow_api.js",
    "test:daily-import": "node test-integration/daily_report_import_api.js",
    "test:verification-reset": "node test-integration/verification_seed_reset.js",
    "preview": "node src/preview-static.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "node test-e2e/daily_report_ui.js",
    "test:e2e-ui": "node test-e2e/ui_redesign.js",
    "test:e2e-advance": "node test-e2e/advance_matrix_ui.js",
    "test:e2e-mobile-masters": "node test-e2e/mobile_master_lists.js",
    "test:e2e-usability": "node test-e2e/list_editor_usability.js",
    "test:e2e-bank-export": "node test-e2e/bank_export_ui.js",
    "capture:manual": "node scripts/capture_manual_screens.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.18.1",
    "iconv-lite": "^0.4.24",
    "multer": "^2.3.0",
    "mysql2": "^3.12.0",
    "playwright": "^1.62.1",
    "read-excel-file": "^6.0.3",
    "unzipper": "^0.12.5"
  }
}
