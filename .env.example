# Links-System 環境変数テンプレート
# コピーして .env を作成: cp .env.example .env

APP_PORT=3000
TZ=Asia/Tokyo

# MariaDB
MYSQL_ROOT_PASSWORD=links_root_change_me
MYSQL_DATABASE=links_system
MYSQL_USER=links
MYSQL_PASSWORD=links_pass_change_me

DB_HOST=db
DB_PORT=3306
DB_NAME=links_system
DB_USER=links
DB_PASSWORD=links_pass_change_me

# セッション（本番では必ず長いランダム文字列に変更）
SESSION_SECRET=links_session_secret_change_me

# 初期管理者（usersが空のときだけ作成）
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=admin1234
ADMIN_DISPLAY_NAME=管理者

# 日報取込原本（コンテナ内。docker-composeの ./data/uploads に保存）
DAILY_REPORT_IMPORT_DIR=/app/uploads/daily-report-imports
DAILY_REPORT_IMPORT_MAX_FILE_SIZE=52428800
DAILY_REPORT_IMPORT_MAX_ROWS=10000
DAILY_REPORT_IMPORT_MAX_COLUMNS=200
DAILY_REPORT_IMPORT_MAX_EXPANDED_SIZE=209715200
