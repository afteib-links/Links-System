# Links-System 環境変数テンプレート
# 実際に使う場合は本ファイルを .env にコピーして値を調整する。

# アプリ（API）ポート
APP_PORT=3000

# データベース接続
# ローカル開発（ネイティブMariaDB）は DB_HOST=127.0.0.1
# Docker Compose 経由は DB_HOST=db
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=links_system
DB_USER=links
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme-root

# 認証（JWT署名鍵）
SESSION_SECRET=changeme

# 初期管理者（未作成時に自動作成される）
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=admin123

# タイムゾーン（締日・勤務日計算のズレ防止）
TZ=Asia/Tokyo
